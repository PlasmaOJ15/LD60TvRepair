[node name="textGreen" type="Label" parent="tutorialScreen" unique_id=1726909400]
visible = false
offset_left = 689.0
offset_top = 485.0
offset_right = 892.0
offset_bottom = 612.0
text = "I'm so green"
label_settings = SubResource("LabelSettings_g4v7s")
