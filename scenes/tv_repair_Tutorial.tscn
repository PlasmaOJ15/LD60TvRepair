[node name="text1" type="Label" parent="tutorialScreen" unique_id=13468958]
visible = false
offset_left = 689.0
offset_top = 485.0
offset_right = 892.0
offset_bottom = 612.0
text = "Welcome to your new job, recruit! I hope you like fixing old TVs, because that is literally all you get to do!"
label_settings = SubResource("LabelSettings_g4v7s")
autowrap_mode = 2

[node name="text2" type="Label" parent="tutorialScreen" unique_id=1434836693]
visible = false
offset_left = 689.0
offset_top = 478.0
offset_right = 876.0
offset_bottom = 690.0
text = "You can start with this one, just rotate the dials and antennae until the static is quiet! There should be a click when you get it right!"
label_settings = SubResource("LabelSettings_g4v7s")
autowrap_mode = 2

[node name="text3" type="Label" parent="tutorialScreen" unique_id=1781395701]
visible = false
offset_left = 689.0
offset_top = 478.0
offset_right = 876.0
offset_bottom = 690.0
text = "Well done! We've stocked the TV above you on that shelf."
label_settings = SubResource("LabelSettings_g4v7s")
autowrap_mode = 2

[node name="text4" type="Label" parent="tutorialScreen" unique_id=1553930678]
visible = false
offset_left = 689.0
offset_top = 478.0
offset_right = 876.0
offset_bottom = 690.0
text = "You should probably look up there during your shift, our TVs tend to have existing, extremely volatile software."
label_settings = SubResource("LabelSettings_g4v7s")
autowrap_mode = 2

[node name="text5" type="Label" parent="tutorialScreen" unique_id=953874538]
visible = false
offset_left = 689.0
offset_top = 478.0
offset_right = 876.0
offset_bottom = 690.0
text = "If that software fails, the TV will immediately break! If too many break, I'm afraid we'll have to fire you."
label_settings = SubResource("LabelSettings_g4v7s")
autowrap_mode = 2

[node name="text6" type="Label" parent="tutorialScreen" unique_id=444364629]
visible = false
offset_left = 689.0
offset_top = 478.0
offset_right = 876.0
offset_bottom = 690.0
text = "Anyways, press the button on the shelf to start your shift! Good luck!"
label_settings = SubResource("LabelSettings_g4v7s")
autowrap_mode = 2

